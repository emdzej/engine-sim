+
+namespace {
+    bool readFromDisk(const std::string &path, std::string *contents) {
+        std::ifstream file(path, std::ios::binary);
+        if (!file.good()) return false;
+        if (contents != nullptr) {
+            std::ostringstream ss;
+            ss << file.rdbuf();
+            *contents = ss.str();
+        }
+        return true;
+    }
+
+    piranha::FileReader s_fileReader = readFromDisk;
+}
+
+void piranha::setFileReader(FileReader reader) {
+    s_fileReader = (reader != nullptr) ? reader : readFromDisk;
+}
+
+bool piranha::readFile(const std::string &path, std::string *contents) {
+    return s_fileReader(path, contents);
+}
+
+#ifdef PIRANHA_NO_BOOST
+
+namespace {
+    // Collapses "." and "..", keeping leading ".." of relative paths
+    std::string normalize(const std::string &path) {
+        const bool absolute = !path.empty() && path[0] == '/';
+        std::vector<std::string> parts;
+        std::string part;
+        std::istringstream ss(path);
+        while (std::getline(ss, part, '/')) {
+            if (part.empty() || part == ".") continue;
+            if (part == ".." && !parts.empty() && parts.back() != "..") parts.pop_back();
+            else if (part == ".." && absolute) continue;
+            else parts.push_back(part);
+        }
+
+        std::string result = absolute ? "/" : "";
+        for (size_t i = 0; i < parts.size(); ++i) {
+            if (i > 0) result += "/";
+            result += parts[i];
+        }
+        return result;
+    }
+
+    std::string filename(const std::string &path) {
+        const size_t slash = path.rfind('/');
+        return (slash == std::string::npos) ? path : path.substr(slash + 1);
+    }
+}
+
+piranha::Path::Path(const std::string &path) { setPath(path); }
+piranha::Path::Path(const char *path) { setPath(std::string(path)); }
+piranha::Path::Path(const Path &path) : m_path(path.m_path) { /* void */ }
+piranha::Path::Path() { /* void */ }
+piranha::Path::~Path() { /* void */ }
+
+std::string piranha::Path::toString() const { return m_path; }
+void piranha::Path::setPath(const std::string &path) { m_path = normalize(path); }
+bool piranha::Path::operator==(const Path &path) const { return m_path == path.m_path; }
+
+piranha::Path piranha::Path::append(const Path &path) const {
+    if (path.isAbsolute() || m_path.empty()) return path;
+    return Path(m_path + "/" + path.m_path);
+}
+
+void piranha::Path::getParentPath(Path *path) const {
+    const size_t slash = m_path.rfind('/');
+    path->m_path = (slash == std::string::npos) ? "" : m_path.substr(0, slash == 0 ? 1 : slash);
+}
+
+const piranha::Path &piranha::Path::operator=(const Path &b) {
+    m_path = b.m_path;
+    return *this;
+}
+
+std::string piranha::Path::getExtension() const {
+    const std::string name = filename(m_path);
+    const size_t dot = name.rfind('.');
+    return (dot == std::string::npos || dot == 0) ? "" : name.substr(dot);
+}
+
+std::string piranha::Path::getStem() const {
+    const std::string name = filename(m_path);
+    const size_t dot = name.rfind('.');
+    return (dot == std::string::npos || dot == 0) ? name : name.substr(0, dot);
+}
+
+bool piranha::Path::isAbsolute() const { return !m_path.empty() && m_path[0] == '/'; }
+bool piranha::Path::exists() const { return readFile(m_path, nullptr); }
