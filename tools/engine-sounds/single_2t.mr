// single_2t: paramotor single-cylinder two-stroke (approximation)
// Sized like a 185 cc paramotor engine (66 x 54 mm); structure adapted from
// assets/engines/atg-video-1/01_honda_trx520.mr. See two_stroke.mr.

import "engine_sim.mr"
import "two_stroke.mr"

units units()
constants constants()
impulse_response_library ir_lib()

private node wires {
    output wire1: ignition_wire();
}

public node paramotor_single_2t {
    alias output __out: engine;

    engine engine(
        name: "Paramotor single 2T (approx., 185 cc)",
        starter_torque: 20 * units.lb_ft,
        starter_speed: 800 * units.rpm,
        redline: 8500 * units.rpm,
        fuel: fuel(max_burning_efficiency: 1.0),
        hf_gain: 0.00121,
        noise: 0.229,
        jitter: 0.42,
        simulation_frequency: 40000
    )

    wires wires()

    crankshaft c0(
        throw: 54 * units.mm / 2,
        flywheel_mass: 1 * units.lb,
        mass: 2 * units.lb,
        friction_torque: 1.0 * units.lb_ft,
        moment_of_inertia: 0.22986844776863666 * 0.05,
        position_x: 0.0,
        position_y: 0.0,
        tdc: constants.pi / 2
    )

    rod_journal rj0(angle: 0.0)
    c0.add_rod_journal(rj0)

    piston_parameters piston_params(
        mass: 120 * units.g,
        compression_height: 0.8 * units.inch,
        wrist_pin_position: 0.0,
        displacement: 0.0
    )

    connecting_rod_parameters cr_params(
        mass: 120.0 * units.g,
        moment_of_inertia: 0.0015884918028487504,
        center_of_mass: 0.0,
        length: 105 * units.mm
    )

    cylinder_bank_parameters bank_params(
        bore: 66 * units.mm,
        deck_height: 54 * units.mm / 2 + 105 * units.mm + 0.8 * units.inch
    )

    intake intake(
        plenum_volume: 0.5 * units.L,
        plenum_cross_section_area: 8.0 * units.cm2,
        intake_flow_rate: k_carb(120.0),
        idle_flow_rate: k_carb(0.0),
        idle_throttle_plate_position: 0.99,
        velocity_decay: 0.5
    )

    exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(300.0),
        primary_tube_length: 14.0 * units.inch,
        primary_flow_rate: k_carb(200.0),
        velocity_decay: 0.5,
        volume: 2.0 * units.L
    )

    exhaust_system exhaust0(
        es_params,
        audio_volume: 1.0,
        impulse_response: ir_lib.mild_exhaust_0_reverb
    )

    cylinder_bank b0(bank_params, angle: 0 * units.deg)
    b0.add_cylinder(
        piston: piston(piston_params, blowby: k_28inH2O(0.1)),
        connecting_rod: connecting_rod(cr_params),
        rod_journal: rj0,
        intake: intake,
        exhaust_system: exhaust0,
        ignition_wire: wires.wire1
    )

    engine.add_cylinder_bank(b0)
    engine.add_crankshaft(c0)

    two_stroke_port_cams cams()

    b0.set_cylinder_head(
        generic_small_engine_head(
            chamber_volume: 20 * units.cc,
            intake_camshaft: cams.intake_cam,
            exhaust_camshaft: cams.exhaust_cam,
            flow_attenuation: 2.0,
            intake_runner_cross_section_area: 8.0 * units.cm2,
            exhaust_runner_cross_section_area: 8.0 * units.cm2
        )
    )

    function timing_curve(1000 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 12 * units.deg)
        .add_sample(2000 * units.rpm, 16 * units.deg)
        .add_sample(5000 * units.rpm, 22 * units.deg)
        .add_sample(9000 * units.rpm, 22 * units.deg)

    engine.add_ignition_module(
        ignition_module(timing_curve: timing_curve, rev_limit: 9500 * units.rpm, two_stroke: true)
            .connect_wire(wires.wire1, 0 * units.deg))
}

public node main {
    set_engine(paramotor_single_2t())
    set_vehicle(vehicle(mass: 100 * units.kg))
    set_transmission(transmission(max_clutch_torque: 50 * units.lb_ft).add_gear(1.0))
}

main()
