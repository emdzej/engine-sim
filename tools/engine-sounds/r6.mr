import "engine_sim.mr"
import "../../assets/engines/bmw/M52B28.mr"

units units()

// M52B28.mr only defines the engine; the vehicle and transmission are
// placeholders (the renderer runs in neutral with the dyno on the crank)
public node main {
    set_engine(M52B28())
    set_vehicle(
        vehicle(
            mass: 1450 * units.kg,
            drag_coefficient: 0.3,
            cross_sectional_area: (70 * units.inch) * (55 * units.inch),
            diff_ratio: 3.15,
            tire_radius: 12 * units.inch,
            rolling_resistance: 300 * units.N
        ))
    set_transmission(
        transmission(
            max_clutch_torque: 300 * units.lb_ft
        )
        .add_gear(4.2)
        .add_gear(2.49)
        .add_gear(1.66)
        .add_gear(1.24)
        .add_gear(1.0))
}

main()
