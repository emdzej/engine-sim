// Shared parts for approximated two-stroke engines.
//
// Engine Sim only simulates poppet-valve four-strokes. These approximate a
// piston-ported two-stroke: valves that open once per crank revolution,
// symmetric about bottom dead centre (exhaust port, then transfer ports),
// and an ignition module with two_stroke: true (a spark every revolution).
// There is no crankcase compression, so scavenging is weaker than a real
// two-stroke; the firing rate and pulse shape are what this aims for.

import "engine_sim.mr"

units units()

// Camshaft angle runs at half crank speed; cam 0 is firing TDC, so the two
// BDCs of one cam revolution (= two crank revolutions) are at cam 90 and 270
public node two_stroke_port_cams {
    input exhaust_duration: 180 * units.deg;    // crank degrees, centred on BDC
    input transfer_duration: 125 * units.deg;
    input exhaust_lift: 400 * units.thou;
    input transfer_lift: 400 * units.thou;
    input gamma: 0.7;
    input base_radius: 0.5 * units.inch;
    input angle: 0 * units.deg;                 // cam offset for this cylinder (crank degrees / 2)

    output intake_cam: _intake_cam;
    output exhaust_cam: _exhaust_cam;

    camshaft _intake_cam(
        camshaft_parameters(advance: 0, base_radius: base_radius),
        lobe_profile: harmonic_cam_lobe(
            duration_at_50_thou: transfer_duration, gamma: gamma, lift: transfer_lift, steps: 100))
    camshaft _exhaust_cam(
        camshaft_parameters(advance: 0, base_radius: base_radius),
        lobe_profile: harmonic_cam_lobe(
            duration_at_50_thou: exhaust_duration, gamma: gamma, lift: exhaust_lift, steps: 100))

    _intake_cam
        .add_lobe(90 * units.deg + angle)
        .add_lobe(270 * units.deg + angle)
    _exhaust_cam
        .add_lobe(90 * units.deg + angle)
        .add_lobe(270 * units.deg + angle)
}
